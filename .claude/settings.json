{
  "permissions": {
    "allow": [
      "Bash(git:*)",
      "Bash(tmux:*)",
      "Bash(ls:*)",
      "Bash(bun run:*)",
      "Bash(bun install:*)",
      "Bash(bun add:*)",
      "Bash(bun outdated:*)",
      "Bash(scripts/agent-verify:*)",
      "Bash(mkdir:*)",
      "Bash(code:*)",
      "WebFetch(domain:*)",
      "Read(~/.zshrc)"
    ],
    "ask": ["Bash(git push:*)", "Bash(git * push)", "Bash(git * push *)"],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(sudo:*)",
      "Bash(curl:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./config/credentials.json)"
    ]
  }
}
