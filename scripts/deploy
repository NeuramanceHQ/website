#!/usr/bin/env bash
set -euo pipefail

site=${NEURAMANCE_SITE:-/srv/neuramance}
caddyfile=${NEURAMANCE_CADDYFILE:-/etc/caddy/neuramance.caddy}
repo=$(cd "$(dirname "$0")/.." && pwd)
export NEXT_TELEMETRY_DISABLED=1

exec 9>"$site/deploy.lock"
flock --nonblock 9 || exit 0

report() {
    timeout 30 gh api --silent "repos/NeuramanceHQ/site/statuses/$sha" \
        -f state="$1" -f context=deploy/i9 -f description="$2" -f target_url=https://neuramance.com \
        || echo "could not report $1 to GitHub" >&2
}

fail() {
    echo "$sha: $1" >&2
    echo "$sha" > "$site/failed"
    report failure "$1"
    exit 1
}

sha=$(timeout 30 gh api repos/NeuramanceHQ/site/git/ref/heads/main --jq .object.sha)
[[ $sha =~ ^[0-9a-f]{40}$ ]] || { echo "GitHub returned an invalid main sha: $sha" >&2; exit 1; }
[ "$(readlink "$site/current" || true)" = "releases/$sha" ] && exit 0
[ "$(cat "$site/failed" 2>/dev/null || true)" = "$sha" ] && exit 0
timeout 30 git -C "$repo" cat-file -e "$sha^{commit}" 2>/dev/null || timeout 60 git -C "$repo" fetch --quiet origin main
timeout 60 git -C "$repo" checkout --quiet --detach "$sha"
if ! timeout 30 git -C "$repo" show "$sha:Caddyfile" | cmp -s - "$caddyfile"; then
    if [ "$(cat "$site/waiting" 2>/dev/null || true)" != "$sha" ]; then
        echo "$sha: Caddyfile differs from $caddyfile; install it with sudo" >&2
        report pending "Waiting for the new Caddyfile to be installed with sudo"
        echo "$sha" > "$site/waiting"
    fi
    exit 0
fi

if [ ! -d "$site/releases/$sha" ]; then
    build=$(mktemp -d "$site/build.XXXXXX")
    trap 'rm -rf "$build"' EXIT
    report pending "Building on i9"
    timeout 120 git -C "$repo" archive "$sha" | tar -x -C "$build" || fail "could not extract the commit"
    (
        cd "$build" || exit 1
        for attempt in 1 2 3; do
            timeout 300 bun install --frozen-lockfile </dev/null && break
            [ "$attempt" -lt 3 ] || exit 1
            timeout 30 sleep "${NEURAMANCE_INSTALL_RETRY_DELAY:-$((attempt * 10 - 5))}" || exit 1
        done
        timeout 900 bun run build </dev/null
    ) || fail "build failed"
    mkdir -p "$site/releases"
    mv "$build/out" "$site/releases/$sha"
fi
touch "$site/releases/$sha"
ln -sfn "releases/$sha" "$site/current.next"
mv -T "$site/current.next" "$site/current"
report success "Live on neuramance.com"
echo "$sha is live"
find "$site/releases" -mindepth 1 -maxdepth 1 -printf '%T@ %f\n' | sort -rn | tail -n +6 \
    | while read -r _ old; do rm -rf "${site:?}/releases/$old"; done
